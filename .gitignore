__pycache__/
*.pyc
*.pyo

# 截图产出物
out/
*.png
*.jpg

# 运行日志：目录留着，内容不入库（只放行说明文件）
# 注意必须写成 log/* 而不是 log/ ——整块排除父目录时 git 根本不会进去，
# 后面的 ! 取反就不生效了，于是连 README 也一起被挡掉。
log/*
!log/README.md

# 模型与数据集（体积大，用脚本下载）
models/
data/
*.onnx
*.pt

.env
.venv/
venv/

# IDE
.idea/
.vscode/

# 用户私人便签，不入库
_note.md
*.stackdump

# 引擎二进制与模型，体积大，用脚本自行下载
engine/

# WorkBuddy 会话私有数据，不入库
.workbuddy/
